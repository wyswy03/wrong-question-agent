# 错题本 - systemd
[Unit]
Description=Wrong Question Agent
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/wrong-question-agent
Environment=PORT=8765
Environment=WRONG_QUESTION_BANK_DIR=/var/lib/wrong-question
EnvironmentFile=-/etc/wrong-question.env
ExecStart=/usr/bin/python3 -u /opt/wrong-question-agent/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
